{
  "name": "@ulthon/ul-opencode-event",
  "version": "0.1.0",
  "description": "OpenCode notification plugin - sends email when session events occur",
  "author": "augushong",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/augushong/ul-opencode-event.git"
  },
  "bugs": {
    "url": "https://gitee.com/augushong/ul-opencode-event/issues"
  },
  "homepage": "https://gitee.com/augushong/ul-opencode-event#readme",
  "keywords": [
    "opencode",
    "plugin",
    "notification",
    "email",
    "smtp"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@types/nodemailer": "^6.4.0",
    "@typescript-eslint/parser": "^8.0.0",
    "bun-types": "^1.3.10",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0"
  }
}
