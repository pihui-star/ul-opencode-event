{
  "name": "@ulthon/ul-opencode-event",
  "version": "0.3.0",
  "description": "OpenCode notification plugin - sends notifications via email, DingTalk, or Feishu when session events occur",
  "author": [
    {
      "name": "Ulthon",
      "url": "https://gitee.com/ulthon/ul-opencode-event"
    },
    {
      "name": "pihuiarch",
      "url": "https://github.com/pihui-star/ul-opencode-event"
    }
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ul-opencode-event": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pihui-star/ul-opencode-event.git"
  },
  "bugs": {
    "url": "https://github.com/pihui-star/ul-opencode-event/issues"
  },
  "homepage": "https://github.com/pihui-star/ul-opencode-event#readme",
  "keywords": [
    "opencode",
    "plugin",
    "notification",
    "email",
    "smtp",
    "dingtalk",
    "feishu",
    "cli"
  ],
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.7",
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@types/node": "^22.15.24",
    "@types/nodemailer": "^6.4.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1"
  }
}
