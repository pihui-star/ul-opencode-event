{
  "_comment": "OpenCode 通知插件配置示例",
  "_description": "配置 SMTP 邮件通知，支持 IPv4/IPv6",
  "_ipv4_ipv6_docs": {
    "default": "自动支持 IPv4 和 IPv6，无需配置",
    "force_ipv4": "设置 localAddress 为 IPv4 地址（如 0.0.0.0）",
    "force_ipv6": "设置 localAddress 为 IPv6 地址（如 ::）",
    "ipv6_host": "可以直接使用 IPv6 地址作为 host"
  },
  "channels": [
    {
      "type": "smtp",
      "enabled": true,
      "name": "QQ邮箱 (自动 IPv4/IPv6)",
      "config": {
        "host": "smtp.qq.com",
        "port": 465,
        "secure": true,
        "auth": {
          "user": "your@qq.com",
          "pass": "your-authorization-code"
        }
      },
      "recipients": ["receiver@example.com"],
      "events": {
        "created": false,
        "idle": true,
        "error": true
      }
    },
    {
      "type": "smtp",
      "enabled": false,
      "name": "强制使用 IPv4",
      "config": {
        "host": "smtp.qq.com",
        "port": 465,
        "secure": true,
        "localAddress": "0.0.0.0",
        "auth": {
          "user": "your@qq.com",
          "pass": "your-authorization-code"
        }
      },
      "recipients": ["receiver@example.com"],
      "events": {
        "idle": true,
        "error": true
      },
      "_note": "设置 localAddress 为 0.0.0.0 强制使用 IPv4 连接"
    },
    {
      "type": "smtp",
      "enabled": false,
      "name": "强制使用 IPv6",
      "config": {
        "host": "smtp.example.com",
        "port": 465,
        "secure": true,
        "localAddress": "::",
        "auth": {
          "user": "your@example.com",
          "pass": "your-password"
        }
      },
      "recipients": ["receiver@example.com"],
      "events": {
        "idle": true,
        "error": true
      },
      "_note": "设置 localAddress 为 :: 强制使用 IPv6 连接"
    },
    {
      "type": "smtp",
      "enabled": false,
      "name": "IPv6 地址作为主机",
      "config": {
        "host": "2001:db8::1",
        "port": 465,
        "secure": true,
        "auth": {
          "user": "your@example.com",
          "pass": "your-password"
        }
      },
      "recipients": ["receiver@example.com"],
      "events": {
        "idle": true,
        "error": true
      },
      "_note": "直接使用 IPv6 地址作为 host 参数"
    }
  ]
}
