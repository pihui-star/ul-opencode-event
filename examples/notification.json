{
  "_comment": "OpenCode 通知插件配置示例",
  "_description": "配置多个通知渠道，支持 SMTP 邮件通知",
  "_templateVariables": {
    "{{eventType}}": "事件类型 (created, idle, error)",
    "{{timestamp}}": "时间戳 (ISO 8601 格式)",
    "{{projectName}}": "项目名称",
    "{{sessionId}}": "会话ID",
    "{{message}}": "消息内容 (idle 事件专用)",
    "{{error}}": "错误信息 (error 事件专用)",
    "{{duration}}": "任务耗时 (idle 事件专用)"
  },
  "channels": [
    {
      "type": "smtp",
      "enabled": true,
      "name": "公司邮箱",
      "config": {
        "host": "smtp.company.com",
        "port": 465,
        "secure": true,
        "auth": {
          "user": "your-email@company.com",
          "pass": "your-app-password"
        }
      },
      "recipients": ["admin@company.com", "dev-team@company.com"],
      "events": {
        "created": true,
        "idle": true,
        "error": true
      },
      "templates": {
        "created": {
          "subject": "[OpenCode] 任务开始 - {{projectName}}",
          "body": "任务已开始\n\n项目: {{projectName}}\n时间: {{timestamp}}\n会话ID: {{sessionId}}"
        },
        "idle": {
          "subject": "[OpenCode] 任务完成 - {{projectName}}",
          "body": "任务已完成\n\n项目: {{projectName}}\n时间: {{timestamp}}\n耗时: {{duration}}\n消息: {{message}}"
        },
        "error": {
          "subject": "[OpenCode] 任务错误 - {{projectName}}",
          "body": "任务发生错误\n\n项目: {{projectName}}\n时间: {{timestamp}}\n错误: {{error}}"
        }
      }
    },
    {
      "type": "smtp",
      "enabled": true,
      "name": "个人邮箱",
      "config": {
        "host": "smtp.qq.com",
        "port": 465,
        "secure": true,
        "auth": {
          "user": "your@qq.com",
          "pass": "your-auth-code"
        }
      },
      "recipients": ["personal@example.com"],
      "events": {
        "idle": true,
        "error": true
      }
    },
    {
      "type": "smtp",
      "enabled": false,
      "name": "备用邮箱（已禁用）",
      "config": {
        "host": "smtp.backup.com",
        "port": 587,
        "secure": false,
        "auth": {
          "user": "backup@backup.com",
          "pass": "backup-password"
        }
      },
      "recipients": ["backup@backup.com"],
      "events": {
        "error": true
      }
    }
  ]
}
